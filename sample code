/*Formula to calculate compound interest annually is given by: 
 Amount= P(1 + R/100)t
Compound Interest = Amount - P*/

//#include <iostream>
#include <bits/stdc++.h>
using namespace std;
int main(){
	double principle=1000,rate=5,time=2,CI;
	double A=principle*((pow((1+rate/100),time)));
	CI=A-principle;
	cout<<"The Ci is:"<<CI;
	return 0;
}




